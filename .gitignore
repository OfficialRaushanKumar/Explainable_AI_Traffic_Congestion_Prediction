!data/.gitkeep
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/augmented/.gitkeep
!models/.gitkeep
!outputs/.gitkeep
!outputs/heatmaps/.gitkeep
!outputs/reports/.gitkeep
!outputs/visualizations/.gitkeep

